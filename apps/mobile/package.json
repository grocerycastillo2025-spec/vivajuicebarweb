{
  "name": "@juicebar/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ./scripts/with-env.mjs expo start",
    "android": "node ./scripts/with-env.mjs expo start --android",
    "ios": "node ./scripts/with-env.mjs expo start --ios",
    "web": "node ./scripts/with-env.mjs expo start --web",
    "build:web": "node ./scripts/with-env.mjs expo export --platform web --output-dir dist && node ./scripts/web-postbuild.mjs dist",
    "lint": "eslint app src",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/__tests__/*.test.ts'",
    "lock:native": "node --experimental-strip-types ./scripts/lock-native.mts",
    "doctor": "expo-doctor",
    "check:supabase": "node ./scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.18",
    "expo-build-properties": "~57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.19",
    "expo-web-browser": "~57.0.2",
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@juicebar/shared-types": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
