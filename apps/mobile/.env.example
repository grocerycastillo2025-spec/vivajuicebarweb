# =====================================================================
# Plantilla de variables de entorno para correr la app en tu computadora.
# Copiar a .env.local y rellenar. NUNCA versionar el archivo con valores.
#
# Todo lo que empieza por EXPO_PUBLIC_ viaja a la app y es PÚBLICO: aquí
# solo va la clave publicable (anon) de Supabase, jamás service_role ni
# llaves de Stripe o PayPal (esas van en Supabase → Edge Functions →
# Secrets).
# =====================================================================

EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
